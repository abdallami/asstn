// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"

}
model Membre {
  id              String      @id @default(cuid())
  nom             String
  prenom          String
  filiere         String
  universite      String
  promotion       String?
  telephone       String?
  photoUrl        String?
  role            RoleBureau?
  cotisationAJour Boolean     @default(false)
  createdAt       DateTime    @default(now())
}

enum RoleBureau {
  PRESIDENT
  VICE_PRESIDENT
  SECRETAIRE_GENERAL
  TRESORIER
  CHARGE_COMMUNICATION
  AUTRE
}

model Actualite {
  id        String   @id @default(cuid())
  titre     String
  contenu   String
  imageUrl  String?
  publiePar String
  createdAt DateTime @default(now())
}

model Evenement {
  id          String   @id @default(cuid())
  titre       String
  description String
  lieu        String?
  dateEvent   DateTime
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Document {
  id         String   @id @default(cuid())
  titre      String
  fichierUrl String
  categorie  String?
  createdAt  DateTime @default(now())
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  nom            String
  createdAt      DateTime @default(now())
}